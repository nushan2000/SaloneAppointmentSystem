# Build stage
FROM node:18-alpine as build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Build with env variables
ARG REACT_APP_USER_SERVICE_URL
ARG REACT_APP_APPOINTMENT_SERVICE_URL
ARG REACT_APP_NOTIFICATION_SERVICE_URL

ENV REACT_APP_USER_SERVICE_URL=$REACT_APP_USER_SERVICE_URL
ENV REACT_APP_APPOINTMENT_SERVICE_URL=$REACT_APP_APPOINTMENT_SERVICE_URL
ENV REACT_APP_NOTIFICATION_SERVICE_URL=$REACT_APP_NOTIFICATION_SERVICE_URL

RUN npm run build

# Production stage
FROM node:18-alpine
WORKDIR /app
COPY --from=build /app/build ./build
RUN npm install -g serve

EXPOSE 3000
CMD ["serve", "-s", "build", "-l", "3000"]
